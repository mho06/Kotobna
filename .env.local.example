# Supabase (public - safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=https://dddxqaberfptqholmmmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-here

# Supabase service role key - server-side ONLY, powers admin writes
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

# Admin panel password
ADMIN_PASSWORD=change-me

# ImageKit (can reuse the same ImageKit account as Verso, or use a separate one)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key

# Gemini (for admin auto-fill-from-photo)
GEMINI_API_KEY=your-gemini-key

# WhatsApp contact number for inquiries (country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=961XXXXXXXX
